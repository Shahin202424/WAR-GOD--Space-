# ==============================================================================
# Junior Astronaut Mission Trainer - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your personal NASA API key if available.
# A free NASA API key can be obtained at: https://api.nasa.gov/
# ==============================================================================

PORT=3000

# Official NASA Open API Key (Used for api.nasa.gov endpoints)
NASA_API_KEY=YOUR_NASA_API_KEY_HERE

# NASA Data Service Base URLs
NASA_DONKI_BASE_URL=https://api.nasa.gov/DONKI
NASA_CCMC_DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI/WS/get
NASA_OSDR_BASE_URL=https://osdr.nasa.gov/osdr/data/osd/meta
NASA_RADLAB_BASE_URL=https://visualization.osdr.nasa.gov/radlab/api
NASA_MARS_TREK_BASE_URL=https://trek.nasa.gov
